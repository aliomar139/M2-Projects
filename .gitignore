# ==========================================
# Git Ignore for M2-Projects Repository
# ==========================================

# --- Operating System Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# --- IDE and Editor Configurations ---
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# --- Microsoft Office Temporary & Lock Files ---
~$*.pptx
~$*.docx
~$*.xlsx

# --- Research Data & Confidential Survey Records ---
# Protect participant-level survey records and raw response sheets
**/data.csv
**/data.xlsx
**/*Responses*.csv
**/*Responses*.xlsx
**/BAT-*.pdf
**/BAT-S_ENG.pdf
tmp/
temp/

# --- Python & Data Science Environments ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/
.ipynb_checkpoints

# --- Logs & Runtime Output ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
